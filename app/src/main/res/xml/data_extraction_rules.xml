<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: do not back up / transfer the saved server login (token). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="soundwave_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="soundwave_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
